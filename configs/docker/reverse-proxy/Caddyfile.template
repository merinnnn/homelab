{
    admin localhost:2019
    skip_install_trust
}

http://:8080 {
    respond /healthz "ok" 200
}

proxy.@DOMAIN@ {
    tls internal
    root * /etc/caddy/current/site
    file_server
}

pve01.@DOMAIN@ {
    tls internal
    reverse_proxy https://192.168.1.2:8006 {
        transport http {
            tls_trust_pool file /etc/caddy/current/trust/pve01-ca.crt
        }
    }
}

pve02.@DOMAIN@ {
    tls internal
    reverse_proxy https://192.168.1.3:8006 {
        transport http {
            tls_trust_pool file /etc/caddy/current/trust/pve02-ca.crt
        }
    }
}

pihole01.@DOMAIN@ {
    tls internal
    redir / /admin/ 302
    reverse_proxy http://192.168.1.210:80
}

pihole02.@DOMAIN@ {
    tls internal
    redir / /admin/ 302
    reverse_proxy http://192.168.1.150:80
}

uptime.@DOMAIN@ {
    tls internal
    reverse_proxy http://192.168.1.58:3001
}
